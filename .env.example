APP_ENV=local
DATABASE_URL=postgresql+asyncpg://paper:paper@postgres:5432/paper
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_WS_SPOT_URL=wss://stream.bybit.com/v5/public/spot
BYBIT_WS_LINEAR_URL=wss://stream.bybit.com/v5/public/linear
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT
VIRTUAL_CAPITAL_USDT=100000
MAX_ACTIVE_NOTIONAL_PCT=0.20
MAX_TOTAL_DEPLOYED_PCT=0.60
MAX_OPEN_POSITIONS=3
DEFAULT_LEVERAGE=2
MAX_LEVERAGE=3
SPOT_TAKER_FEE_BPS=10
PERP_TAKER_FEE_BPS=5.5
SLIPPAGE_BPS=2
FUNDING_HORIZON_PERIODS=3
FUNDING_PERSISTENCE_PERIODS=2
FUNDING_COST_SAFETY_FACTOR=2
SPREAD_ENTRY_THRESHOLD_BPS=30
SPREAD_EXIT_THRESHOLD_BPS=5
MARKET_POLL_SECONDS=60
ENABLE_FUNDING_UNIVERSE_SCAN=true
FUNDING_SCAN_LIMIT=30
MIN_FUNDING_SCAN_TURNOVER_USDT=10000000
SIGNAL_NOTIFICATION_COOLDOWN_SECONDS=900
ENABLE_MARKET_EVENT_LOOP=true
STALE_MARKET_DATA_SECONDS=10
MAX_DRAWDOWN_PCT=0.15
MAX_SYMBOL_EXPOSURE_PCT=0.25
DELTA_MISMATCH_PCT=0.03
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_NOTIFY_CHAT_ID=
